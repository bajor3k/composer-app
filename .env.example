# Copy to .env.local and fill in. Every value below is a placeholder.

# --- Supabase (runtime data access) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Database (Prisma schema + seed script only; runtime queries use Supabase JS) ---
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Azure AI Foundry agents ---
# Auth is Microsoft Entra only (DefaultAzureCredential): run `az login` locally,
# or assign a managed identity in Azure. No API key is used.
AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_WORKSPACE_AGENT_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxx
AZURE_AI_ALERTS_AGENT_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxx
AZURE_AI_REPORTS_AGENT_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Scheduled jobs (cron routes require `Authorization: Bearer $CRON_SECRET`) ---
CRON_SECRET=generate-a-long-random-string

# --- Optional ---
# Live market data scheduler (see src/lib/market/)
# MARKET_REFRESH_MS=30000
# MARKET_SCHEDULER=off
# MARKET_PERSIST=1

# SEC EDGAR requires a descriptive User-Agent with contact info: "Org Name email@domain"
# SEC_USER_AGENT="Your Org you@example.com"

# Alert email notifications (Resend) — not wired yet; see src/lib/alerts/notify.ts
# RESEND_API_KEY=
# ALERTS_FROM_EMAIL=alerts@example.com

# "Create ticket" card files into a Jira project. Server-side only.
# ATLASSIAN_SITE_URL=https://your-site.atlassian.net
# ATLASSIAN_EMAIL=you@example.com
# ATLASSIAN_API_TOKEN=
# JIRA_PROJECT_KEY=

# ETF look-through in the Terminal (no OpenBB server ships with this repo)
# OPENBB_URL=http://127.0.0.1:8100
